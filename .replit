modules = ["nodejs-24", "go-1.25", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "cloudrun"


[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
